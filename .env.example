# ============================================================
# Application
# ============================================================
APP_NAME=RealEstateRAG
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ============================================================
# API Server
# ============================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# ============================================================
# LLM Configuration
# ============================================================
LLM_API_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=300
LLM_MAX_RETRIES=3

# ============================================================
# FalkorDB Configuration
# ============================================================
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH_NAME=wolbu_v3
FALKORDB_POOL_SIZE=10

# ============================================================
# Storage Configuration
# ============================================================
DATA_DIR=/workspace/data
OUTPUT_DIR=./output
STORAGE_BACKEND=local

# S3 Configuration (when STORAGE_BACKEND=s3)
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ============================================================
# Monitoring & Observability
# ============================================================
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_TRACING=false
TRACING_ENDPOINT=

# LangSmith (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=realestaterag

# ============================================================
# Security
# ============================================================
API_KEY_HEADER=X-API-Key
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8501"]

# ============================================================
# Cache Configuration
# ============================================================
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_BACKEND=memory

# ============================================================
# Rate Limiting
# ============================================================
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
