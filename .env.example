# Environment Variables for Real Estate RAG
# Copy this file to .env and fill in your secrets

# ==================== LangSmith Configuration ====================
# Get your API key from: https://smith.langchain.com/settings

# LangSmith API Key (required for prompt versioning)
LANGSMITH_API_KEY=""

# LangSmith Project Name (optional, default: realEstateAnalyzer)
LANGSMITH_PROJECT="realEstateAnalyzer"

# Enable LangSmith Tracing (optional, default: false)
LANGSMITH_TRACING="true"

# LangSmith API Endpoint (optional, default: https://api.smith.langchain.com)
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"


# ==================== LLM API Configuration ====================
# For local vLLM/llama.cpp servers, use default "EMPTY"
# For cloud APIs (OpenAI, etc), set your actual API key

# API Key (optional, default: EMPTY for local servers)
# API_KEY="EMPTY"

# Model API URL (optional, override config.yaml)
# API_URL="http://localhost:8000/v1"


# ==================== Database Configuration ====================
# FalkorDB Connection (optional, override config.yaml)
# FALKORDB_URL="redis://localhost:6379"


# ==================== AWS Secrets Manager ====================
# Optional: Use AWS Secrets Manager instead of .env
# Requires: pip install boto3
# AWS_REGION="ap-northeast-2"
# AWS_SECRET_NAME="realEstateAnalyzer/secrets"


# ==================== GCP Secret Manager ====================
# Optional: Use GCP Secret Manager instead of .env
# Requires: pip install google-cloud-secret-manager
# GCP_PROJECT="your-project-id"
# GCP_SECRET_NAME="realEstateAnalyzer-secrets"
